# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (optional: if missing, app runs with in-memory storage)
MONGO_URI=mongodb://127.0.0.1:27017/ai_legal_emergency_support
MONGO_DB_NAME=ai_legal_emergency_support

# Auth
JWT_SECRET=your-secret-key

# OpenAI (optional: AI features disabled if missing)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_PROVIDER=auto

# If you are using Google Gemini API keys (often start with "AIza..."):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-1.5-flash

# Backwards compatibility (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Cloudinary (optional: photo uploads disabled if missing)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Twilio (optional: SMS on missing person approval disabled if missing)

# Backwards compatibility:
# TWILIO_FROM_NUMBER=

# Email / Nodemailer (optional: confirmation and approval emails disabled if missing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Police Station Finder uses OpenStreetMap (Overpass + Nominatim) — no API key.
